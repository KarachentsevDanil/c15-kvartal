{
  "permissions": {
    "deny": [
      "Read(./.env)"
    ],
    "ask": [
      "Bash(npm run db:reset*)",
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_schedule_message"
    ],
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test *)",
      "Bash(npm run lint)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "npm.pkg.github.com"]
    }
  }
}
