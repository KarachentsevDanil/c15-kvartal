{
  "name": "kvartal-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/store/run-migrations.ts",
    "db:reset": "tsx src/store/run-reset.ts",
    "db:seed": "tsx stand/seed.ts",
    "dokat:stub": "node stand/dokat/server.mjs"
  },
  "dependencies": {
    "@kvartal/dokat-client": "1.4.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
