{
  "name": "kvartal-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit"
  },
  "dependencies": {
    "@kvartal/dokat-client": "1.4.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
